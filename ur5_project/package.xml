<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ur5_project</name>
  <version>0.1.0</version>
  <description>
    UR5 kinematics and dynamics simulation. Final project for course
    362-1-4231 (Kinematics and Dynamics of Robots), Ben-Gurion University,
    Spring 2026. Includes analytical forward and inverse kinematics,
    workspace analysis, Jacobian, statics, and trajectory planning,
    integrated with ROS2 Jazzy and Gazebo Harmonic.
  </description>

  <maintainer email="daniel@example.com">Daniel</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>tf2_ros</depend>
  <depend>python3-numpy</depend>
  <depend>python3-matplotlib</depend>

  <exec_depend>ur_description</exec_depend>
  <exec_depend>ur_simulation_gz</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
